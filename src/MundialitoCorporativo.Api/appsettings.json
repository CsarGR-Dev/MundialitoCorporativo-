{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplySchemaOnStartup": true,
    "SeedOnStartup": true,
    "ConnectionRetries": 10,
    "ConnectionRetryDelay": "00:00:05"
  },
  "Idempotency": {
    "Expiration": "1.00:00:00",
    "InProgressTimeout": "00:02:00",
    "CleanupInterval": "01:00:00"
  },
  "Observability": {
    "ServiceName": "mundialito-api",
    "ConsoleFormat": "Json",
    "LogFilePath": "logs/mundialito-.json",
    "RetainedLogFiles": 7,
    "SlowRequestThreshold": "00:00:00.500",
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
