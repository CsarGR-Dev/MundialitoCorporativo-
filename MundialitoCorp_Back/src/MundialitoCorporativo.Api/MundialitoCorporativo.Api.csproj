<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Interfaz para explorar y probar la API sobre el documento OpenAPI (solo en desarrollo). -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    <!-- Observabilidad (ítem 7): logs estructurados con Serilog sobre ILogger. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <!-- Trazas distribuidas con OpenTelemetry, exportadas por OTLP (por ejemplo, a Jaeger). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
  </ItemGroup>

  <!--
    Api solo orquesta: los controladores usan Application.
    La referencia a Infrastructure existe únicamente para registrar dependencias en Program.cs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\MundialitoCorporativo.Application\MundialitoCorporativo.Application.csproj" />
    <ProjectReference Include="..\MundialitoCorporativo.Infrastructure\MundialitoCorporativo.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Los logs locales (logs/*.json) no son contenido del proyecto: no se copian a bin ni se publican. -->
  <ItemGroup>
    <Content Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MundialitoCorporativo.UnitTests" />
    <InternalsVisibleTo Include="MundialitoCorporativo.IntegrationTests" />
  </ItemGroup>

</Project>
