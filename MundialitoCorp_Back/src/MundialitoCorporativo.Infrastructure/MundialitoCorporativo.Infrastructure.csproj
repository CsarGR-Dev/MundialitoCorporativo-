<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure implementa los contratos definidos en Application. -->
  <ItemGroup>
    <ProjectReference Include="..\MundialitoCorporativo.Application\MundialitoCorporativo.Application.csproj" />
    <ProjectReference Include="..\MundialitoCorporativo.Domain\MundialitoCorporativo.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Escritura (Commands) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Lectura (Queries) -->
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- Microsoft.Data.SqlClient trae System.Security.Cryptography.Pkcs 9.0.11, con vulnerabilidades
         conocidas (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Se fija la versión corregida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Scripts de estructura: la API crea la base con ellos al iniciar (Docker, ítem 9). Única definición del esquema. -->
  <ItemGroup>
    <EmbeddedResource Include="Initialization\Scripts\*.sql" LogicalName="Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Las implementaciones son internas; solo las pruebas pueden instanciarlas directamente. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MundialitoCorporativo.UnitTests" />
    <InternalsVisibleTo Include="MundialitoCorporativo.IntegrationTests" />
  </ItemGroup>

</Project>
